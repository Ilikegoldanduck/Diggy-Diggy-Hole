local enemy = require("assets.scripts.enemy")
local player = require("assets.scripts.player")
local map = require("assets.scripts.map")

go.property("id", 0)

local monsterNum = 4

function init(self)	
	local ted = (enemy.getid(self.id) - 1) * (1 / monsterNum)
	go.set("#sprite", "cursor", ted)
end

function damage(self, dmg, fromPlayer)
	if enemy.damage(self.id, dmg) then
		msg.post("/main#main", "died", {self.id})
		if fromPlayer then
			if enemy.getid(self.id) == 3 then
				player.increaseScore(500)
			else
				player.increaseScore(50 * enemy.getid(self.id))
			end
		end
		go.delete()
	end
end

function move(self, start, stop)

	local indexVal = monsterNum * 4
	local ted = (enemy.getid(self.id) - 1) * (1 / monsterNum)

	if not enemy.checkPos(stop[1], stop[2]) then
		if map.getTile(stop[1], stop[2]) == 0 and not enemy.getid(self.id) == 3 then
			map.destroyTile(stop[1], stop[2])
			msg.post("/main#main", "break", {stop[1], stop[2]})
		else
		if map.getTile(stop[1], stop[2]) == 3 and (enemy.getid(self.id) ~= 3 and enemy.getid(self.id) ~= 4) then
				damage(self, 1, false)
			end
			enemy.changePos(self.id, {stop[1], stop[2]})
			go.set_position(vmath.vector3(16 * stop[1], 16 * stop[2], 1))
		end
		if stop[2] - start[2] < 0 then --Additions
			go.set("#sprite", "cursor", ted)
		elseif stop[2] - start[2] > 0 then
			go.set("#sprite", "cursor", (2 / indexVal) + ted)
		elseif stop[1] - start[1] > 0 then --Additions
			go.set("#sprite", "cursor", (1 / indexVal) + ted)
		else
			go.set("#sprite", "cursor", (3 / indexVal) + ted)
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("turn") then
		for i = 1, enemy.move(self.id), 1 do
			local temppos = enemy.pos(self.id)
			local distance = math.abs(message[1] - temppos[1]) + math.abs(message[2] - temppos[2])
			if distance <= enemy.range(self.id) then
				msg.post("/main#main", "attack", {enemy.attack(self.id)})
				if enemy.getid(self.id) == 4 then
					damage(self, 1, false)
				end
			elseif distance <= 20 or enemy.getid(self.id) == 3 then
				if message[1] - temppos[1] == 0 and (map.getTile(temppos[1], temppos[2] - ((temppos[2] - message[2]) / math.abs(message[2] - temppos[2]))) <= 2  or enemy.getid(self.id) == 3) then
					move(self, temppos, {temppos[1], temppos[2] - ((temppos[2] - message[2]) / math.abs(message[2] - temppos[2]))})
				elseif message[2] - temppos[2] == 0 and (map.getTile(temppos[1] - ((temppos[1] - message[1]) / math.abs(message[1] - temppos[1])), temppos[2]) <= 2 or enemy.getid(self.id) == 3) then
					move(self, temppos, {temppos[1] - ((temppos[1] - message[1]) / math.abs(message[1] - temppos[1])), temppos[2]})
				else	
					local x = temppos[1] - ((temppos[1] - message[1]) / math.abs(message[1] - temppos[1]))
					local y = temppos[2] - ((temppos[2] - message[2]) / math.abs(message[2] - temppos[2]))
					if (map.getTile(temppos[1], y) <= 2 or enemy.getid(self.id) == 3) and map.getTile(x, temppos[2]) < map.getTile(temppos[1], y) and not enemy.checkPos(temppos[1], y) then
						move(self, temppos, {temppos[1], y})
					elseif (map.getTile(x, temppos[2]) <= 2 or enemy.getid(self.id) == 3) and map.getTile(x, temppos[2]) > map.getTile(temppos[1], y) and not enemy.checkPos(x, temppos[2]) then
						move(self, temppos, {x, temppos[2]})
					else
						if x < y and (map.getTile(temppos[1], y) ~= 4 or enemy.getid(self.id) == 3) then
							move(self, temppos, {temppos[1], y})
						elseif (map.getTile(x, temppos[2]) ~= 4 or enemy.getid(self.id) == 3) then
							move(self, temppos, {x, temppos[2]})
						end
					end
				end
			else
				local done = true
				local counter = 0
				while done or counter < 3 do
					local chosenDirection = math.random(1, 4)
					counter = counter + 1
					local x, y = temppos[1] + (-1 * (2 - chosenDirection) * (chosenDirection % 2)), temppos[2] + (-1 * (chosenDirection - 3) * ((chosenDirection - 1) % 2))
					if x > 0 and x <= 40 and y > 0 and y <= 24 and not (enemy.checkPos(x, y) or (map.getTile(x, y) == 4 and enemy.getid(self.id) ~= 3)) then
						move(self, temppos, {x, y})
						done = false
					end
				end
			end	
		end
		msg.post("/main#main", "turnfin")
	elseif message_id == hash("damage") then
		damage(self, message[1], true)
	end
end