function on_message(self, message_id, message, sender)
	if message_id == hash("turn") then
		for i = 1, enemy.move(self.id), 1 do
			local temppos = enemy.pos(self.id)
			local distance = math.abs(message[1] - temppos[1]) + math.abs(message[2] - temppos[2])
			if distance <= enemy.range(self.id) then
				msg.post("/main#main", "attack", {enemy.attack(self.id)})
			elseif distance <= 20 then
				pprint(distance)
				if message[1] - temppos[1] == 0 then
					if map.getTile(temppos[1], temppos[2] - ((temppos[2] - message[2]) / math.abs(message[2] - temppos[2]))) == 0 then
						msg.post("/main#main", "break", {temppos[1], temppos[2] - ((temppos[2] - message[2]) / math.abs(message[2] - temppos[2]))})
					else
						enemy.changePos(self.id, {temppos[1], temppos[2] - ((temppos[2] - message[2]) / math.abs(message[2] - temppos[2]))})
						go.set_position(vmath.vector3(16 * temppos[1], 16 * (temppos[2] - ((temppos[2] - message[2]) / math.abs(message[2] - temppos[2]))), 1))
					end
				elseif message[2] - temppos[2] == 0 then
					if map.getTile(temppos[1] - ((temppos[1] - message[1]) / math.abs(message[1] - temppos[1])), temppos[2]) == 0 then
						msg.post("/main#main", "break", {temppos[1] - ((temppos[1] - message[1]) / math.abs(message[1] - temppos[1])), temppos[2]})
					else
						enemy.changePos(self.id, {temppos[1] - ((temppos[1] - message[1]) / math.abs(message[1] - temppos[1])), temppos[2]})
						go.set_position(vmath.vector3(16 * (temppos[1] - ((temppos[1] - message[1]) / math.abs(message[1] - temppos[1]))), 16 * temppos[2], 1))
					end
				else	
					local x = temppos[1] - ((temppos[1] - message[1]) / math.abs(message[1] - temppos[1]))
					local y = temppos[2] - ((temppos[2] - message[2]) / math.abs(message[2] - temppos[2]))
					if map.getTile(x, temppos[2]) < map.getTile(temppos[1], y) then
						enemy.changePos(self.id, {temppos[1], y})
						go.set_position(vmath.vector3(16 * temppos[1], 16 * y, 1))
					elseif map.getTile(x, temppos[2]) > map.getTile(temppos[1], y) then
						enemy.changePos(self.id, {x, temppos[2]})
						go.set_position(vmath.vector3(16 * x, 16 * temppos[2], 1))
					else
						if x < y then
							if map.getTile(temppos[1], y) == 0 then
								msg.post("/main#main", "break", {temppos[1], y})
							else
								enemy.changePos(self.id, {temppos[1], y})
								go.set_position(vmath.vector3(16 * temppos[1], 16 * y, 1))
							end
						else
							if map.getTile(x, temppos[2]) == 0 then
								msg.post("/main#main", "break", {x, temppos[2]})
							else
								enemy.changePos(self.id, {x, temppos[2]})
								go.set_position(vmath.vector3(16 * x, 16 * temppos[2], 1))
							end
						end
					end
				end
			else
				local done = true
				while done do
					local chosenDirection = math.random(1, 4)
					local x, y = temppos[1] + (-1 * (2 - chosenDirection) * (chosenDirection % 2)), temppos[2] + (-1 * (chosenDirection - 3) * ((chosenDirection - 1) % 2))
					if x > 0 and x <= 40 and y > 0 and y <= 24 then
						if map.getTile(x, y) == 0 then
							msg.post("/main#main", "break", {x, y})
						else
							enemy.changePos(self.id, {x, y})
							go.set_position(vmath.vector3(16 * x, 16 * y, 1))
						end
						done = false
					end
				end
			end
		end		
		msg.post("/main#main", "turnfin")
	elseif message_id == hash("damage") then
		if enemy.damage(self.id, message[1]) then
			msg.post("/main#main", "died", {self.id})
			player.increaseScore(50)
			go.delete()
		end
	end
end

