function move(self, start, stop)
	local ted = (enemy.getid(self.id) - 1) * .5
	if not enemy.checkPos(stop[1], stop[2]) then
		if map.getTile(stop[1], stop[2]) == 0 then
			map.destroyTile(stop[1], stop[2])
			msg.post("/main#main", "break", {stop[1], stop[2]})
		else
			enemy.changePos(self.id, {stop[1], stop[2]})
			go.set_position(vmath.vector3(16 * stop[1], 16 * stop[2], 1))
		end
		if stop[2] - start[2] < 0 then --Additions
			go.set("#sprite", "cursor", ted)
		elseif stop[2] - start[2] > 0 then
			go.set("#sprite", "cursor", .25 + ted)
		elseif stop[1] - start[1] > 0 then --Additions
			go.set("#sprite", "cursor", .125 + ted)
		else
			go.set("#sprite", "cursor", .375 + ted)
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("turn") then
		local temppos = enemy.pos(self.id)
		local ted = (enemy.getid(self.id) - 1) * .5
		for i = 1, enemy.move(self.id), 1 do
			local distance = math.abs(message[1] - temppos[1]) + math.abs(message[2] - temppos[2])
			if distance <= enemy.range(self.id) then
				msg.post("/main#main", "attack", {enemy.attack(self.id)})
			elseif distance <= 20 then
				if message[1] - temppos[1] == 0 then
					move(self, temppos, {temppos[1], temppos[2] - ((temppos[2] - message[2]) / math.abs(message[2] - temppos[2]))})
				elseif message[2] - temppos[2] == 0 then
					move(self, temppos, {temppos[1] - ((temppos[1] - message[1]) / math.abs(message[1] - temppos[1])), temppos[2]})
				else	
					local x = temppos[1] - ((temppos[1] - message[1]) / math.abs(message[1] - temppos[1]))
					local y = temppos[2] - ((temppos[2] - message[2]) / math.abs(message[2] - temppos[2]))
					if map.getTile(x, temppos[2]) < map.getTile(temppos[1], y) and not enemy.checkPos(temppos[1], y) then
						move(self, temppos, {temppos[1], y})
					elseif map.getTile(x, temppos[2]) > map.getTile(temppos[1], y) and not enemy.checkPos(x, temppos[2]) then
						move(self, temppos, {x, temppos[2]})
					else
						if x < y then
							move(self, temppos, {temppos[1], y})
						else
							move(self, temppos, {x, temppos[2]})
						end
					end
				end
			else
				local done = true
				local counter = 0
				while done or counter < 3 do
					local chosenDirection = math.random(1, 4)
					counter = counter + 1
					local x, y = temppos[1] + (-1 * (2 - chosenDirection) * (chosenDirection % 2)), temppos[2] + (-1 * (chosenDirection - 3) * ((chosenDirection - 1) % 2))
					if x > 0 and x <= 40 and y > 0 and y <= 24 and not enemy.checkPos(x, y) then
						move(self, temppos, {x, y})
						done = false
					end
				end
			end
		end		
		msg.post("/main#main", "turnfin")
	elseif message_id == hash("damage") then
		if enemy.damage(self.id, message[1]) then
			msg.post("/main#main", "died", {self.id})
			player.increaseScore(50 * enemy.getid(self.id))
			go.delete()
		end
	end
end

