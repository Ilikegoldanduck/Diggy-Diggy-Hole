local player = require("assets.scripts.player")
local enemy = require("assets.scripts.enemy")
local map = require("assets.scripts.map")

local chosenDirection = nil
--clockwise starting at up

local moveCd = true

local level = {}
local levelCounter = 1

local playerPos = {1, 1}

local enemyTable = {}


function checkEnemies(x, y, dmg)
	for i, v in ipairs(enemyTable) do
		local temppos = enemy.pos(i)
		if go.exists(v) and x == temppos[1] and y == temppos[2] then
			msg.post(v, "damage", {dmg})
		end
	end
end

function generateLevel()

	for i, v in ipairs(enemyTable) do
		if go.exists(v) then
			go.delete(v)
		end
	end
	enemyTable = {}
	enemy.reset()

	map.generate(playerPos[1], playerPos[2])
	
	level = map.getLevel()

	local x, y = 1, 1
	timer.delay(0, true, function(self, handle)
		for i = 1, 4, 1 do
			j = level[x][y]
			if j == 0 or j == 1 or j == 2 then
				tilemap.set_tile("#level", "layer1", x, y, j + 1)
			elseif j == -1 then --High health Low Range
				tilemap.set_tile("#level", "layer1", x, y, 2)
				table.insert(enemyTable, factory.create("#enemyFactory", vmath.vector3(16 * x, 16 * y, 1), nil, {id = enemy.create(1, {x, y})}, 1))
				level[x][y] = 1
			elseif j == -2 then --Low health High Range
				tilemap.set_tile("#level", "layer1", x, y, 2)
				table.insert(enemyTable, factory.create("#enemyFactory", vmath.vector3(16 * x, 16 * y, 1), nil, {id = enemy.create(2, {x, y})}, 1))
				level[x][y] = 1
			end
			x = x + 1
			if x > #level then
				y = y + 1
				x = 1
			end
			if y > #level[1] then
				msg.post(".", "acquire_input_focus")
				timer.cancel(handle)
			end
		end
	end)
end

function levelFin()
	levelCounter = levelCounter + 1
	msg.post(".", "release_input_focus")
	chosenDirection = nil
	generateLevel()
end

local inprog = true

function enemiesTurn()
	for i, v in ipairs(enemyTable) do
		if go.exists(v) then
			msg.post(v, "turn", playerPos)
			inprog = true
			timer.delay(1, true, function(self, handle)
				if not improg then
					timer.cancel(handle)
				end
			end)
		end
	end
	player.newTurn()
end

function init(self)
	map.initialize()
end

function update(self, dt)
	if chosenDirection then
		for i = -1, 1, 1 do
			for k = -1, 1, 1 do
				local x, y = playerPos[1] + i, playerPos[2] + k
				if (x > 0 and x <= #level and y > 0 and y <= #level[1]) and tilemap.get_tile("#level", "layer1", x, y) ~= level[x][y] + 1 then
					tilemap.set_tile("#level", "layer1", x, y, level[x][y] + 1)
				end
			end
		end
		local x, y = playerPos[1] + (-1 * (2 - chosenDirection) * (chosenDirection % 2)), playerPos[2] + (-1 * (chosenDirection - 3) * ((chosenDirection - 1) % 2))
		if x > 0 and x <= #level and y > 0 and y <= #level[1] then
			tilemap.set_tile("#level", "layer1", x, y, level[x][y] + 4)
		end
	end
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("init") then
		generateLevel()
	elseif message_id == hash("attack") then
		player.damage(message[1])
		if player.getHealth() <= 0 then
			levelCounter = 1
			generateLevel()
		end
	elseif message_id == hash("break") then
		level[message[1]][message[2]] = 1
		tilemap.set_tile("#level", "layer1", message[1], message[2], level[message[1]][message[2]] + 1)
		map.destroyTile(message[1], message[2])
	elseif message_id == hash("turnfin") then
		inprog = false
	end
end

function on_input(self, action_id, action)
	if action.pressed then
		if action_id == hash("up") then
			chosenDirection = 2
		elseif action_id == hash("down") then
			chosenDirection = 4
		elseif action_id == hash("left") then
			chosenDirection = 1
		elseif action_id == hash("right") then
			chosenDirection = 3
		elseif moveCd and chosenDirection then
			local x, y = playerPos[1] + (-1 * (2 - chosenDirection) * (chosenDirection % 2)), playerPos[2] + (-1 * (chosenDirection - 3) * ((chosenDirection - 1) % 2))
			if x > 0 and x <= #level and y > 0 and y <= #level[1] then
				if action_id == hash("space") and (level[x][y] == 1 or level[x][y] == 2) then
					moveCd = false
					go.set_position(vmath.vector3((16 * x) - 16, (16 * y) + 9, 0), go.get_id("/player"))
					playerPos = {x, y}
					player.doMove()
					timer.delay(.25, false, function()
						moveCd = true
					end)
					if level[x][y] == 2 then
						levelFin()
					end
				elseif action_id == hash("primary") then
					moveCd = false
					if level[x][y] == 0 then
						level[x][y] = 1
						map.destroyTile(x, y)
					else
						checkEnemies(x, y, player.attack(1))
					end
					player.doMove()
					timer.delay(.25, false, function()
						moveCd = true
					end)
				elseif action_id == hash("secondary") and player.getCD() == 0 then
					player.resetCD()
					moveCd = false
					for i = 1, player.getRange(2), 1 do
						local x, y = playerPos[1] + (-1 * i * (2 - chosenDirection) * (chosenDirection % 2)), playerPos[2] + (-1 * i * (chosenDirection - 3) * ((chosenDirection - 1) % 2))
						if x > 0 and x <= #level and y > 0 and y <= #level[1] then
							if level[x][y] == 0 then
								level[x][y] = 1
								map.destroyTile(x, y)
								tilemap.set_tile("#level", "layer1", x, y, level[x][y] + 1)
							else
								checkEnemies(x, y, player.attack(2))
							end
						end
					end
					player.doMove()
					timer.delay(.25, false, function()
						moveCd = true
					end)
				end
				if player.getMoves() == 0 or action_id == hash("skip") then
					enemiesTurn()
				end
			end
		end
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
