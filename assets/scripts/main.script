local player = require("assets.scripts.player")
local enemy = require("assets.scripts.enemy")
local map = require("assets.scripts.map")

local chosenDirection = nil
--clockwise starting at up

local level = {}

local playerPos = {1, 1}

function generateLevel()
	map.generate(1, 1)
	
	level = map.getLevel()

	local x, y = 1, 1
	timer.delay(.00005, true, function(self, handle)
		j = level[x][y]
		if j == 0 or j == 1 or j == 2 then
			tilemap.set_tile("#level", "layer1", x, y, j + 1)
		elseif j == -1 then
			tilemap.set_tile("#level", "layer1", x, y, 2)
		elseif j == -2 then
			tilemap.set_tile("#level", "layer1", x, y, 2)
		end
		x = x + 1
		if x > #level then
			y = y + 1
			pprint(y)
			x = 1
		end
		if y == #level[1] then
			timer.cancel(handle)
		end
	end)
end

function enemiesTurn()

end

function init(self)
	map.initialize()
end

function update(self, dt)
	if chosenDirection then
		for i = -1, 1, 1 do
			for k = -1, 1, 1 do
				if tilemap.get_tile("#level", "layer1", playerPos[1] + i, playerPos[2] + k) ~= level[i][k] + 1 then
					tilemap.set_tile("#level", "layer1", i, k, level[i][k] + 1)
				end
			end
		end
		local x, y = playerPos[1] + (-1 * (2 - chosenDirection) * (chosenDirection % 2)), playerPos[2] + (-1 * (1 - chosenDirection) * ((chosenDirection - 1) % 2))
		tilemap.set_tile("#level", "layer1", x, y, level[i][k] + 4)
	end
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("init") then
		generateLevel()
		msg.post(".", "acquire_input_focus")
	end
end

function on_input(self, action_id, action)
	if action.pressed then
		local x, y = 0, 0
		if message_id == hash("up") then
			chosenDirection = 1
		elseif message_id == hash("down") then
			chosenDirection = 3
		elseif message_id == hash("left") then
			chosenDirection = 4
		elseif message_id == hash("right") then
			chosenDirection = 2
		else
			if message_id == hash("space") then
				player.doMove()
				playerPos = {playerPos[1] + x. playerPos[2] + y}
			elseif message_id == hash("primary") then
				player.doMove()
			elseif message_id == hash("secondary") and player.getCD() == 0 then
				player.resetCD()
				player.doMove()
			end
			if player.getMoves() == 0 or message_id == hash("skip") then
				enemiesTurn()
				player.newTurn()
			end
		end
		
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
