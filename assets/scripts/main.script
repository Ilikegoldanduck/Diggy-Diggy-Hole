local player = require("assets.scripts.player")
local enemy = require("assets.scripts.enemy")
local map = require("assets.scripts.map")

local chosenDirection = "left"

local level = {}

local playerPos = {1, 1}

function generateLevel()
	map.generate(1, 1)
	
	level = map.getLevel()

	local x, y = 1, 1
	timer.delay(.0025, true, function(self, handle)
		j = level[x][y]
		if j == 0 or j == 1 or j == 2 then
			tilemap.set_tile("#level", "layer1", x, y, j + 1)
		elseif j == -1 then
			tilemap.set_tile("#level", "layer1", x, y, 2)
		elseif j == -2 then
			tilemap.set_tile("#level", "layer1", x, y, 2)
		end
		x = x + 1
		if x > #level then
			y = y + 1
			x = 1
		end
		if y > #level[1] then
			timer.cancel(handle)
		end
	end)
end

function init(self)
	map.initialize()
end

