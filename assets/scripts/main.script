local player = require("assets.scripts.player")
local enemy = require("assets.scripts.enemy")
local map = require("assets.scripts.map")

local chosenDirection = nil
--clockwise starting at up

local moveCd = true

local level = {}
local levelCounter = 20

local playerPos = {1, 1}

local enemyTable = {}
local healthTable = {}

function checkEnemies(x, y, dmg)
	for i, v in ipairs(enemyTable) do
		local temppos = enemy.pos(i)
		if go.exists(v) and x == temppos[1] and y == temppos[2] then
			msg.post(v, "damage", {dmg})
			sound.play("#thud")
		end
	end
end

function checkEnemiesCollision(x, y)
	for i, v in ipairs(enemyTable) do
		local temppos = enemy.pos(i)
		if go.exists(v) and x == temppos[1] and y == temppos[2] then
			return false
		end
	end
	return true
end

function checkPacks(x, y)
	for i, v in ipairs(healthTable) do
		if v[2] == x and v[3] == y then
			go.delete(v[1])
			table.remove(healthTable, i)
			player.heal(2)
		end
	end
end

function generateLevel()

	player.newTurn()

	msg.post("/gui#main menu", "newLevel", {levelCounter})

	for i, v in ipairs(enemyTable) do
		if go.exists(v) then
			go.delete(v)
		end
	end
	for i, v in ipairs(healthTable) do
		go.delete(v[1])
	end

	enemyTable = {}
	healthTable = {}
	enemy.reset()

	map.generate(playerPos[1], playerPos[2], levelCounter)
	
	level = map.getLevel()

	local x, y = 1, 1
	timer.delay(0, true, function(self, handle)
		for i = 1, 4, 1 do
			j = level[x][y]
			if j >= 0 then
				tilemap.set_tile("#level", "layer1", x, y, j + 1)
			elseif j < 0 and j >= -3 then --Enemy spawner
				tilemap.set_tile("#level", "layer1", x, y, 2)
				table.insert(enemyTable, factory.create("#enemyFactory", vmath.vector3(16 * x, 16 * y, 1), nil, {id = enemy.create(-j, {x, y})}, 1))
				level[x][y] = 1
				map.destroyTile(x, y)
			elseif j == -4 then
				tilemap.set_tile("#level", "layer1", x, y, 2)
				table.insert(healthTable, {factory.create("#healthFactory", vmath.vector3(16 * x, 16 * y, 1), nil, nil), x, y})
				level[x][y] = 1
				map.destroyTile(x, y)
			end
			x = x + 1
			if x > #level then
				y = y + 1
				x = 1
			end
			if y > #level[1] then
				msg.post(".", "acquire_input_focus")
				timer.cancel(handle)
			end
		end
	end)
end

function levelFin()
	levelCounter = levelCounter + 1
	msg.post(".", "release_input_focus")
	chosenDirection = nil
	player.increaseScore(200)
	generateLevel()
end

local inprog = false

function enemiesTurn()
	for i, v in ipairs(enemyTable) do
		if go.exists(v) then
			msg.post(v, "turn", playerPos)
			inprog = true
		end
	end
	timer.delay(1, true, function(self, handle)
		if not improg then
			player.newTurn()
			timer.cancel(handle)
		end
	end)
end

function init(self)
	map.initialize()
end

function update(self, dt)
	if chosenDirection then
		for i = -1, 1, 1 do
			for k = -1, 1, 1 do
				local x, y = playerPos[1] + i, playerPos[2] + k
				if (x > 0 and x <= #level and y > 0 and y <= #level[1]) and tilemap.get_tile("#level", "layer1", x, y) ~= level[x][y] + 1 then
					tilemap.set_tile("#level", "layer1", x, y, level[x][y] + 1)
				end
			end
		end
		local x, y = playerPos[1] + (-1 * (2 - chosenDirection) * (chosenDirection % 2)), playerPos[2] + (-1 * (chosenDirection - 3) * ((chosenDirection - 1) % 2))
		if x > 0 and x <= #level and y > 0 and y <= #level[1] then
			tilemap.set_tile("#level", "layer1", x, y, level[x][y] + 6)
		end
	end
end

function hurt(damage)
	player.damage(damage)
	if player.getHealth() <= 0 then
		msg.post(".", "release_input_focus")	
		msg.post("/gui#main menu", "newGame", {levelCounter})
		for x = 1, #level, 1 do
			for y = 1, #level[1], 1 do
				tilemap.set_tile("#level", "layer1", x, y, 1)
			end
		end
		levelCounter = 1
		playerPos = {1, 1}
		go.set_position(vmath.vector3(0, 25, 0), go.get_id("/player"))
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("init") then
		generateLevel()
	elseif message_id == hash("attack") then
		hurt(message[1])
	elseif message_id == hash("break") then
		level[message[1]][message[2]] = 1
		tilemap.set_tile("#level", "layer1", message[1], message[2], level[message[1]][message[2]] + 1)
		map.destroyTile(message[1], message[2])
	elseif message_id == hash("turnfin") then
		inprog = false
	end
end

function doMove()
	moveCd = false

	player.doMove()
	timer.delay(.1, false, function()
		moveCd = true
	end)
end

local inputTable = {hash("down"), hash("right"), hash("up"), hash("left")}

function checkMovement(action_id)
	for i, v in ipairs(inputTable) do
		if v == action_id then
			go.set("/player#sprite", "cursor", .25 * (i - 1))
			chosenDirection = 5 - i
			return true
		end
	end
end

function on_input(self, action_id, action)
	if action.pressed and not inprog then
		if checkMovement(action_id) then
			
		elseif player.getMoves() > 0 and moveCd and chosenDirection then
			local x, y = playerPos[1] + (-1 * (2 - chosenDirection) * (chosenDirection % 2)), playerPos[2] + (-1 * (chosenDirection - 3) * ((chosenDirection - 1) % 2))
			if x > 0 and x <= #level and y > 0 and y <= #level[1] then
				if action_id == hash("space") and (level[x][y] == 1 or level[x][y] == 2 or level[x][y] == 3) and checkEnemiesCollision(x, y) then
					doMove()
					checkPacks(x, y)
					go.set_position(vmath.vector3((16 * x) - 16, (16 * y) + 9, 0), go.get_id("/player"))
					playerPos = {x, y}
					if level[x][y] == 2 then
						levelFin()
					elseif level[x][y] == 3 then
						hurt(1)
					end
				elseif action_id == hash("primary") and (level[x][y] == 0 or level[x][y] == 4 or not checkEnemiesCollision(x, y)) then
					doMove()
					if level[x][y] == 0 then
						sound.play("#dig")
						level[x][y] = 1
						map.destroyTile(x, y)
						player.increaseScore(20)
					elseif level[x][y] == 4 then
						sound.play("#lav")
						level[x][y] = 3
						map.destroyTile(x, y)
						player.increaseScore(30)
					end
					checkEnemies(x, y, player.attack(1))
				elseif action_id == hash("secondary") and player.getCD() == 0 then
					doMove()
					sound.play("#dig")
					player.resetCD()
					for i = 1, player.getRange(2), 1 do
						local x, y = playerPos[1] + (-1 * i * (2 - chosenDirection) * (chosenDirection % 2)), playerPos[2] + (-1 * i * (chosenDirection - 3) * ((chosenDirection - 1) % 2))
						if x > 0 and x <= #level and y > 0 and y <= #level[1] then
							if level[x][y] == 0 then

								level[x][y] = 1
								map.destroyTile(x, y)
								player.increaseScore(25)
								tilemap.set_tile("#level", "layer1", x, y, level[x][y] + 1)
							else
								checkEnemies(x, y, player.attack(2))
							end
						end
					end
				end
				if player.getMoves() == 0 or action_id == hash("skip") then
					player.setMoves(0)
					enemiesTurn()
				end
			end
		end
	end
end