function on_message(self, message_id, message, sender)
	if message_id == hash("init") then
		generateLevel()
		msg.post(".", "acquire_input_focus")
	end
end

function on_input(self, action_id, action)
	if message_id == hash("up") and action.pressed then
		chosenDirection = "up"
	elseif message_id == hash("down") and action.pressed then
		chosenDirection = "down"
	elseif message_id == hash("left") and action.pressed then
		chosenDirection = "left"
	elseif message_id == hash("right") and action.pressed then
		chosenDirection = "right"
	end
	if message_id == hash("space") and action.pressed then
		
	end
end

