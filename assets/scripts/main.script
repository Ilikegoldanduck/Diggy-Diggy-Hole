local player = require("assets.scripts.player")
local enemy = require("assets.scripts.enemy")
local map = require("assets.scripts.map")

local chosenDirection = nil
--clockwise starting at up

local level = {}

local playerPos = {1, 1}

function generateLevel()
	map.generate(1, 1)
	
	level = map.getLevel()

	local x, y = 1, 1
	timer.delay(.000001, true, function(self, handle)
		j = level[x][y]
		if j == 0 or j == 1 or j == 2 then
			tilemap.set_tile("#level", "layer1", x, y, j + 1)
		elseif j == -1 then
			tilemap.set_tile("#level", "layer1", x, y, 2)
		elseif j == -2 then
			tilemap.set_tile("#level", "layer1", x, y, 2)
		end
		x = x + 1
		if x > #level then
			y = y + 1
			x = 1
		end
		if y == #level[1] then
			msg.post(".", "acquire_input_focus")
			timer.cancel(handle)
		end
	end)
end

function enemiesTurn()

end

function init(self)
	map.initialize()
end

function update(self, dt)
	if chosenDirection then
		for i = -1, 1, 1 do
			for k = -1, 1, 1 do
				local x, y = playerPos[1] + i, playerPos[2] + k
				if (x > 0 and x <= #level and y > 0 and y <= #level[1]) and tilemap.get_tile("#level", "layer1", x, y) ~= level[x][y] + 1 then
					tilemap.set_tile("#level", "layer1", x, y, level[x][y] + 1)
				end
			end
		end
		local x, y = playerPos[1] + (-1 * (2 - chosenDirection) * (chosenDirection % 2)), playerPos[2] + (-1 * (chosenDirection - 3) * ((chosenDirection - 1) % 2))
		if x > 0 and x <= #level and y > 0 and y <= #level[1] then
			tilemap.set_tile("#level", "layer1", x, y, level[x][y] + 4)
		end
	end
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("init") then
		generateLevel()
		pprint("hihi")
	end
end

function on_input(self, action_id, action)
	if action.pressed then
		if action_id == hash("up") then
			chosenDirection = 2
		elseif action_id == hash("down") then
			chosenDirection = 4
		elseif action_id == hash("left") then
			chosenDirection = 1
		elseif action_id == hash("right") then
			chosenDirection = 3
		else
			local x, y = playerPos[1] + (-1 * (2 - chosenDirection) * (chosenDirection % 2)), playerPos[2] + (-1 * (chosenDirection - 3) * ((chosenDirection - 1) % 2))
			if x > 0 and x <= #level and y > 0 and y <= #level[1] then
				if action_id == hash("space") and level[x][y] == 1 then
					go.set_position(vmath.vector3((16 * x) - 16, (16 * y) + 9, 0), go.get_id("/player"))
					playerPos = {x, y}
					player.doMove()
				elseif action_id == hash("primary") then
					if level[x][y] == 0 then
						level[x][y] = 1
						map.destroyTile(x, y)
					end
					player.doMove()
				elseif action_id == hash("secondary") and player.getCD() == 0 then
					player.resetCD()
					for i = 1, player.getRange(2), 1 do
						local x, y = playerPos[1] + (-1 * i * (2 - chosenDirection) * (chosenDirection % 2)), playerPos[2] + (-1 * i * (chosenDirection - 3) * ((chosenDirection - 1) % 2))
						if x > 0 and x <= #level and y > 0 and y <= #level[1] then
							if level[x][y] == 0 then
								map.destroyTile(x, y)
							end
						end
					end
					player.doMove()
				end
				if player.getMoves() == 0 or action_id == hash("skip") then
					enemiesTurn()
					player.newTurn()
				end
			end
		end
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
