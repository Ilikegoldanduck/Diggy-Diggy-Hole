local player = require("assets.scripts.player")

local inMenu = true

function closeMenu()
	gui.set_visible(gui.get_node("Level"), false)
	gui.set_visible(gui.get_node("backlayer"), false)
	gui.set_visible(gui.get_node("logo"), false)
	gui.set_visible(gui.get_node("instructions"), false)
	gui.set_visible(gui.get_node("Game Over"), false)
	gui.set_visible(gui.get_node("info"), true)
end

function init(self)
	msg.post(".", "acquire_input_focus")
end

function update(self, dt)
	gui.set_text(gui.get_node("info"), "Health: " .. player.getHealth() .. " | Moves Left: " .. player.getMoves() .. " | Secondary CD: " .. player.getCD() )
end

function on_message(self, message_id, message, sender)
	if message_id == hash("newLevel") then
		gui.set_text(gui.get_node("Level"), "Level " .. tostring(message[1]))
		gui.set_visible(gui.get_node("Level"), true)
		timer.delay(4, false, function()
			gui.set_visible(gui.get_node("Level"), false)
		end)
	elseif message_id == hash("newGame") then
		msg.post(".", "acquire_input_focus")
		inMenu = true
		gui.set_visible(gui.get_node("info"), false)
		gui.set_visible(gui.get_node("Game Over"), true)
		gui.set_visible(gui.get_node("instructions"), true)
		gui.set_visible(gui.get_node("backlayer"), true)
		gui.set_visible(gui.get_node("Level"), true)
		gui.set_text(gui.get_node("Level"), "Score: " .. tostring(player.getScore()) .. "\nLevel: " .. message[1])
		gui.set_text(gui.get_node("instructions"), "[Press 'Space' to Restart]")
		player.resetScore()
	end
end

function on_input(self, action_id, action)
	if action_id == hash("space") and action.pressed then
		closeMenu()
		inMenu = false
		msg.post("/main#main", "init")
		msg.post(".", "release_input_focus")
	end
end