local inMenu = true

function closeMenu()
	gui.set_visible(gui.get_node("backlayer"), false)
	gui.set_visible(gui.get_node("start"), false)
end

function init(self)
	msg.post(".", "acquire_input_focus")
end

function update(self, dt)
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
end

function on_input(self, action_id, action)
	if action_id == hash("space") or (action_id == hash("touch") and gui.pick_node(gui.get_node("start"), action.x, action.y)) then
		closeMenu()
		inMenu = false
		msg.post("/main#main", "init")
		msg.post(".", "release_input_focus")
	end
end